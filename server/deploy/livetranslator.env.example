# 托管服务 systemd EnvironmentFile 样例
# 拷成 /etc/livetranslator/livetranslator.env 再改；部署步骤见 ../DEPLOY.md

# 听译模型目录（桌面端下好的那份拷过来，或单独放）
LIVE_TRANSLATOR_MODELS=/opt/livetranslator/models

# 账号库：单机 SQLite 文件即可；以后加机器换 Postgres DSN（ADR 0032/0018）
LIVE_TRANSLATOR_DB=/var/lib/livetranslator/hosted.sqlite3
# LIVE_TRANSLATOR_DB_DSN=postgresql://user:pass@host/dbname

# 路数闸：先按默认（cpu/4）上线，跑 tools/load_probe.py 标定后改写（ADR 0015）
LIVE_TRANSLATOR_HOSTED_MAX_ROUTES=1

# 反代后面必配（ADR 0030 后续）：登录限流与在听记录按 XFF 最右一跳认真实来源。
# 只在进程确实只接本机反代流量时开——直连暴露时开了等于让客户端自报来源。
LIVE_TRANSLATOR_TRUST_PROXY=1

# CORS 收敛：壳（Windows Tauri WebView2）的 origin。逗号分隔可多个。
LIVE_TRANSLATOR_CORS_ORIGINS=http://tauri.localhost

# 只听本机，TLS 由反代终结（ADR 0025）
LIVE_TRANSLATOR_HOST=127.0.0.1
LIVE_TRANSLATOR_PORT=8787
