{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "直播同传工具",
  "version": "0.1.4",
  "identifier": "com.livetranslator.desktop",
  "build": {
    "beforeDevCommand": "pnpm exec vite dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "python tools/prepare_runtime.py && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "直播同传工具",
        "url": "panel.html",
        "width": 352,
        "height": 600,
        "minWidth": 352,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "subtitle",
        "title": "字幕",
        "url": "subtitle.html",
        "width": 860,
        "height": 240,
        "minWidth": 360,
        "minHeight": 96,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "publisher": "LiveTranslator",
    "resources": {
      "runtime/python": "python",
      "runtime/engine": "engine"
    },
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
